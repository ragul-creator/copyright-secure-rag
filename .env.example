APP_ENV=dev
DATA_DIR=./data
AUDIT_LOG=./data/audit.jsonl
SQLITE_DB=./data/app.db
DATABASE_URL=

AUTH_MODE=disabled
JWT_SECRET=change-me-in-production
JWT_ISSUER=copyright-secure-rag
JWT_AUDIENCE=copyright-secure-rag-api

LLM_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

OPA_URL=http://localhost:8181/v1/data/copyright/decision
OPA_RIGHTS_URL=http://localhost:8181/v1/data/rights/decision
FAIL_CLOSED=true
REQUIRE_COMPLIANCE_EVIDENCE=false

VECTOR_BACKEND=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=customer_support
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RETRIEVAL_MIN_SCORE=0.12

MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md,.markdown,.html,.htm,.pdf
CORS_ORIGINS=

COPYRIGHT_MAX_EXACT_WORDS=28
COPYRIGHT_NGRAM_THRESHOLD=0.55
COPYRIGHT_FUZZY_THRESHOLD=0.88
COPYRIGHT_SEMANTIC_THRESHOLD=0.96
COPYRIGHT_MINHASH_THRESHOLD=0.70
COPYRIGHT_CANDIDATE_LIMIT=8
COPYRIGHT_LSH_ENABLED=true

NEMO_GUARDRAILS_URL=
GUARDRAILS_AI_URL=
EXTERNAL_GUARDRAILS_FAIL_CLOSED=false

AUDIT_S3_BUCKET=
AUDIT_S3_PREFIX=copyright-rag-audit/
AUDIT_WORM_REQUIRED=false
AUDIT_RETENTION_DAYS=365

OTEL_ENABLED=false
OTEL_SERVICE_NAME=copyright-secure-rag
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Docker Compose database defaults; replace for non-local deployments.
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=rag
